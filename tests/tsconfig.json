{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true
  },
  "include": [
    "../tests/**/*",
    "../test/**/*",
    "../__tests__/**/*",
    "../src/**/*.test.*",
    "../src/**/*.spec.*",
    "../*.test.*",
    "../*.spec.*"
  ],
  "exclude": ["../node_modules", "../dist", "../build"]
}
