OPENAI_API_KEY=
# Required by the hosted service (/api/mcp, upload and download links). Set these only in Vercel/your private .env.local.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
WANDERPAGE_SESSION_PEPPER=
# Rotate separately from owner-session hashing. Stored admission hashes expire after 24 hours.
WANDERPAGE_ADMISSION_PEPPER=
# Hosted generation fails closed unless explicitly enabled. Keep preview and production limits separate.
WANDERPAGE_GENERATION_ENABLED=false
WANDERPAGE_DAILY_GENERATION_LIMIT=25
CRON_SECRET=
# Separate bearer secret for emergency public-story takedown.
WANDERPAGE_OPERATOR_SECRET=
# Hosted MCP endpoint (/api/mcp) and its owner-only OAuth sign-in. Apply db/migrations/0006 and 0007 first.
# The issuer is this deployment's origin; the JWKS URL is <issuer>/oauth/jwks.
WANDERPAGE_OAUTH_ISSUER=
WANDERPAGE_OAUTH_JWKS_URL=
# An ES256 private JWK (JSON) that signs access tokens.
WANDERPAGE_OAUTH_SIGNING_KEY=
WANDERPAGE_GITHUB_OAUTH_CLIENT_ID=
WANDERPAGE_GITHUB_OAUTH_CLIENT_SECRET=
# Only this GitHub login gets a token; set WANDERPAGE_OWNER_SUBJECT to the same login.
OWNER_GITHUB_LOGIN=
WANDERPAGE_OWNER_SUBJECT=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_WRITER_MODEL=gpt-5.6-terra
WIKIMEDIA_USER_AGENT=Wanderpage/0.1 (personal vacation story generator)
WANDERPAGE_PORT=4317
VERCEL_TOKEN=

# Optional: where you will host out/. Adds the hero photo to shared-link previews.
WANDERPAGE_SITE_URL=
