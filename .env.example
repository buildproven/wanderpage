OPENAI_API_KEY=
# Required by the hosted /create flow. Set these only in Vercel/your private .env.local.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
WANDERPAGE_SESSION_PEPPER=
# Rotate separately from owner-session hashing. Stored admission hashes expire after 24 hours.
WANDERPAGE_ADMISSION_PEPPER=
# Hosted generation fails closed unless explicitly enabled. Keep preview and production limits separate.
WANDERPAGE_GENERATION_ENABLED=false
WANDERPAGE_DAILY_GENERATION_LIMIT=25
CRON_SECRET=
# Separate bearer secret for emergency public-story takedown.
WANDERPAGE_OPERATOR_SECRET=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_WRITER_MODEL=gpt-5.6-terra
WIKIMEDIA_USER_AGENT=Wanderpage/0.1 (personal vacation story generator)
WANDERPAGE_PORT=4317
VERCEL_TOKEN=
